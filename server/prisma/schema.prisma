generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String    @unique
  phone     String
  password  String
  bookings  Booking[] 
  bookedAt  DateTime  @default(now())
}

model Booking {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId // Ensure the field matches MongoDB's ObjectId type
  user      User      @relation(fields: [userId], references: [id])
  services  String[]  // Array of service IDs
}

model Service {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  price     Float
}
